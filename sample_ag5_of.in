# Sample input: Ag5 Casida with OF-context (Phase 1)

# ===== File Paths =====
workdir = examples/AG5_PARALLEL
atoms = ag.vasp
density = rho_scf_5.xsf
psi = psi_5.npy
eigs = eig_5.npy
occs = occs_5.npy

# ===== Pseudopotentials =====
pseudo_map = Ag:Ag_ONCV_PBE-1.2.upf

# ===== Calculation Parameters =====
n_occ = 10
n_unocc = 20
n_states = 30
n_total_occ = 48

# ===== Solver Options =====
matrix_free
tda
solver_method = lobpcg
solver_tol = 1e-8
solver_maxiter = 200

# ===== Grid =====
grid_nr = 54 54 54

# ===== Exchange-Correlation =====
xc = PBE
of_context #Needed for Orbital Free

# ===== Spin State =====
spin_state = singlet

# ===== Output =====
output_prefix = casida_ag5_of
plot
sigma = 0.1
